# Copy to keystore.properties (Git ignored), or set FAMILYCARE_SIGNING_PROPERTIES.
# Use a team-owned release key; never commit the actual key or passwords.
# Use forward slashes in paths. Relative paths resolve from this properties file.
storeFile=C:/secure-location/familycare-release.jks
storePassword=REPLACE_LOCALLY
keyAlias=familycare-release
keyPassword=REPLACE_LOCALLY
